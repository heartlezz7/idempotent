  "meta": {
    "title": "Idempotency Lab — Async Queue Flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "order-path",
        "label": "Order path",
        "focus": [
          "producer",
          "orders-topic",
          "order-consumer",
          "order-db"
        ],
        "note": "Producer dedupe, atomic claim, then a version-guarded upsert committed with its outbox row."
      },
      {
        "id": "outbox-relay",
        "label": "Outbox relay",
        "focus": [
          "order-db",
          "relay",
          "notif-topic"
        ],
        "note": "The relay derives dedupe_key outbox:{id}, so a relay retry republishes the same message."
      },
      {
        "id": "inbox-path",
        "label": "Inbox path",
        "focus": [
          "notif-topic",
          "notif-consumer",
          "inbox-db"
        ],
        "note": "Notifications are not naturally idempotent, so the inbox claim commits with the send."
      },
      {
        "id": "chaos",
        "label": "Chaos controls",
        "focus": [
          "lab",
          "orders-topic"
        ],
        "note": "Force a redelivery or expire a lease to prove the safe consumers absorb duplicates."
      }
    ]
  },
