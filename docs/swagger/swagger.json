{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Control plane for the queue/consumer idempotency lab: publish onto a Postgres-backed broker,\nstep naive vs safe consumers, run the outbox relay, and inject redeliveries.\nEvery applied effect appends to audit_log -- read GET /_stats to see whether a redelivery duplicated anything.",
        "title": "Idempotency Lab API (async queue flow)",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/_duplicate": {
            "post": {
                "description": "Resets a message to pending regardless of status, including done -- simulates a broker replay.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chaos"
                ],
                "summary": "Force a redelivery (lab-only)",
                "parameters": [
                    {
                        "description": "Message to redeliver",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.MessageIDRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.RedeliverResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/_expire_lease": {
            "post": {
                "description": "Backdates a leased message so the next claim can steal it.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chaos"
                ],
                "summary": "Expire a lease now (lab-only)",
                "parameters": [
                    {
                        "description": "Leased message",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.MessageIDRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.ExpireLeaseResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/_reset": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "lab"
                ],
                "summary": "Truncate every lab table",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.ResetResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/_stats": {
            "get": {
                "description": "audit_log counts per consumer/op, queue_messages per topic/status, and row counts for orders, notifications, inbox and outbox.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "lab"
                ],
                "summary": "Scoreboard",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.StatsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/naive/consume": {
            "post": {
                "description": "Claims one message and applies it unconditionally: every redelivery duplicates the effect.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "consumers"
                ],
                "summary": "Consume one message (naive)",
                "parameters": [
                    {
                        "enum": [
                            "orders",
                            "notifications"
                        ],
                        "type": "string",
                        "description": "Topic to claim from",
                        "name": "topic",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Lease length in seconds (default 5)",
                        "name": "lease_seconds",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Processed (or model.NoMessagesResponse when the topic is empty)",
                        "schema": {
                            "$ref": "#/definitions/consumer.Outcome"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/publish": {
            "post": {
                "description": "Stand-in for an external producer. dedupe_key is optional; reusing it with the same payload returns the existing message (deduped=true), with a different payload returns 422.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "producer"
                ],
                "summary": "Publish a message",
                "parameters": [
                    {
                        "description": "Message to publish",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.PublishRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/model.PublishResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "dedupe_key_reused_with_different_payload",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/relay/run": {
            "post": {
                "description": "Publishes up to limit unpublished outbox_events rows onto the queue with dedupe_key outbox:{id}.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "relay"
                ],
                "summary": "Run the outbox relay once",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Max rows to publish (default 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.RelayResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/safe/consume": {
            "post": {
                "description": "Orders use a monotonic version guard plus the transactional outbox; notifications use the inbox table. chaos injects a crash before commit or after commit but before ack.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "consumers"
                ],
                "summary": "Consume one message (safe)",
                "parameters": [
                    {
                        "enum": [
                            "orders",
                            "notifications"
                        ],
                        "type": "string",
                        "description": "Topic to claim from",
                        "name": "topic",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Lease length in seconds (default 5)",
                        "name": "lease_seconds",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "crash_before_commit",
                            "crash_after_commit_before_ack"
                        ],
                        "type": "string",
                        "description": "Fault injection point",
                        "name": "chaos",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Processed, skipped, or chaos outcome (or model.NoMessagesResponse when the topic is empty)",
                        "schema": {
                            "$ref": "#/definitions/consumer.Outcome"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "consumer.Outcome": {
            "type": "object",
            "properties": {
                "acked": {
                    "type": "boolean"
                },
                "applied": {
                    "type": "boolean"
                },
                "consumer": {
                    "description": "\"naive\" | \"safe\"",
                    "type": "string"
                },
                "detail": {
                    "type": "string"
                },
                "message_id": {
                    "type": "integer"
                },
                "resource": {
                    "description": "\"order\" | \"notification\"",
                    "type": "string"
                }
            }
        },
        "model.AuditCount": {
            "type": "object",
            "properties": {
                "consumer": {
                    "type": "string",
                    "example": "safe"
                },
                "count": {
                    "type": "integer"
                },
                "op": {
                    "type": "string",
                    "example": "order.apply"
                }
            }
        },
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "topic query param required"
                }
            }
        },
        "model.ExpireLeaseResponse": {
            "type": "object",
            "properties": {
                "lease": {
                    "type": "string",
                    "example": "expired"
                },
                "message_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.MessageIDRequest": {
            "type": "object",
            "required": [
                "message_id"
            ],
            "properties": {
                "message_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.PublishRequest": {
            "type": "object",
            "required": [
                "payload",
                "topic"
            ],
            "properties": {
                "dedupe_key": {
                    "type": "string",
                    "example": "order-123:v2"
                },
                "payload": {
                    "type": "object"
                },
                "topic": {
                    "type": "string",
                    "example": "orders"
                }
            }
        },
        "model.PublishResponse": {
            "type": "object",
            "properties": {
                "deduped": {
                    "type": "boolean"
                },
                "message_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.QueueCount": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "status": {
                    "type": "string",
                    "example": "done"
                },
                "topic": {
                    "type": "string",
                    "example": "orders"
                }
            }
        },
        "model.RedeliverResponse": {
            "type": "object",
            "properties": {
                "message_id": {
                    "type": "integer",
                    "example": 1
                },
                "status": {
                    "type": "string",
                    "example": "pending"
                }
            }
        },
        "model.RelayResponse": {
            "type": "object",
            "properties": {
                "published": {
                    "type": "integer"
                }
            }
        },
        "model.ResetResponse": {
            "type": "object",
            "properties": {
                "reset": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "model.StatsResponse": {
            "type": "object",
            "properties": {
                "audit_log": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.AuditCount"
                    }
                },
                "inbox_processed": {
                    "type": "integer"
                },
                "notifications_sent": {
                    "type": "integer"
                },
                "orders": {
                    "type": "integer"
                },
                "outbox_pending": {
                    "type": "integer"
                },
                "outbox_published": {
                    "type": "integer"
                },
                "queue_messages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.QueueCount"
                    }
                }
            }
        }
    }
}